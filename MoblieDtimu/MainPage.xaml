<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MoblieDtimu.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F5F5">

    <!-- 整体布局：内容区、迷你播放条、底部导航 -->
    <Grid RowDefinitions="*, Auto, Auto">

        <!-- ================= 1. 主内容区 (动态切换) ================= -->
        <ContentView x:Name="MainContentArea" Grid.Row="0">
            <!-- 默认会在这里加载 HomeView -->
        </ContentView>

        <!-- ================= 2. 迷你播放条 (可选，贴近音乐App) ================= -->
        <!-- 如果不需要，可以把这一整块删掉 -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="15,10">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.05" Offset="0,-2" Radius="5" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Image Source="dotnet_bot.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFill" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                    <Label Text="正在播放的歌曲名" FontSize="14" FontAttributes="Bold" TextColor="#333" />
                    <Label Text="歌手名" FontSize="12" TextColor="#888" />
                </VerticalStackLayout>
                <!-- 项目暂无 play_icon.png，用 emoji 占位，后续接 VLC 播放时再换成真按钮 -->
                <Label Grid.Column="2" Text="▶" FontSize="24" TextColor="#333" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- ================= 3. 底部导航栏 ================= -->
        <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.05" Offset="0,-2" Radius="5" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*, *, *, *" HeightRequest="64">

                <!-- Tab 1: 视频
                     外层 Border = 整个 1/4 单元格点击热区（近透明实体背景，否则 Windows 透明区域不参与命中测试）；
                     内层 Border = 选中态视觉胶囊 -->
                <Border Grid.Column="0" StrokeThickness="0" BackgroundColor="#01000000"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0"/>
                    </Border.GestureRecognizers>
                    <Border x:Name="Tab1Background" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent" Padding="14,6"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <VerticalStackLayout x:Name="Tab1" Spacing="2" HorizontalOptions="Center">
                            <Image x:Name="Tab1Icon" Source="vedio.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                            <Label x:Name="Tab1Text" Text="视频" FontSize="12" TextColor="#333" HorizontalOptions="Center" />
                            <!-- 选中指示条：常驻占位（透明度切换，无布局跳动） -->
                            <BoxView x:Name="Tab1Indicator" WidthRequest="20" HeightRequest="3" CornerRadius="1.5" Color="#00FFFF" Opacity="0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>

                <!-- Tab 2: 音乐（同 Tab1 双层结构：外层全格点击区 + 内层选中胶囊） -->
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#01000000"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <Border x:Name="Tab2Background" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent" Padding="14,6"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <VerticalStackLayout x:Name="Tab2" Spacing="2" HorizontalOptions="Center">
                            <Image x:Name="Tab2Icon" Source="musics.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                            <Label x:Name="Tab2Text" Text="音乐" FontSize="12" HorizontalOptions="Center" />
                            <BoxView x:Name="Tab2Indicator" WidthRequest="20" HeightRequest="3" CornerRadius="1.5" Color="#00FFFF" Opacity="0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>

                <!-- Tab 3: 图片（同 Tab1 双层结构） -->
                <Border Grid.Column="2" StrokeThickness="0" BackgroundColor="#01000000"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <Border x:Name="Tab3Background" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent" Padding="14,6"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <VerticalStackLayout x:Name="Tab3" Spacing="2" HorizontalOptions="Center">
                            <Image x:Name="Tab3Icon" Source="pictrues.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                            <Label x:Name="Tab3Text" Text="图片" FontSize="12" HorizontalOptions="Center" />
                            <BoxView x:Name="Tab3Indicator" WidthRequest="20" HeightRequest="3" CornerRadius="1.5" Color="#00FFFF" Opacity="0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>

                <!-- Tab 4: 设置（同 Tab1 双层结构） -->
                <Border Grid.Column="3" StrokeThickness="0" BackgroundColor="#01000000"
                        HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <Border x:Name="Tab4Background" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                            BackgroundColor="Transparent" Padding="14,6"
                            HorizontalOptions="Center" VerticalOptions="Center">
                        <VerticalStackLayout x:Name="Tab4" Spacing="2" HorizontalOptions="Center">
                            <Image x:Name="Tab4Icon" Source="settings.png" WidthRequest="24" HeightRequest="24" Aspect="AspectFit" />
                            <Label x:Name="Tab4Text" Text="设置" FontSize="12" HorizontalOptions="Center" />
                            <BoxView x:Name="Tab4Indicator" WidthRequest="20" HeightRequest="3" CornerRadius="1.5" Color="#00FFFF" Opacity="0" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Border>

            </Grid>
        </Border>
    </Grid>
</ContentPage>