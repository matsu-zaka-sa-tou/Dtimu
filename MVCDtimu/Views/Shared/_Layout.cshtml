<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVCDtimu</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVCDtimu.styles.css" asp-append-version="true" />

    <style>
        /* ===== PJAX 加载态 ===== */
        html.is-navigating #app-main {
            opacity: .55;
            transition: opacity .15s ease;
            pointer-events: none;
        }

        html.is-navigating {
            cursor: progress;
        }
            /* 顶部一根细进度条（可选，不喜欢删掉即可） */
            html.is-navigating::after {
                content: "";
                position: fixed;
                top: 0;
                left: 0;
                height: 2px;
                width: 100%;
                background: linear-gradient(90deg, transparent, #1b6ec2, transparent);
                background-size: 200% 100%;
                animation: pjax-bar 1s linear infinite;
                z-index: 9999;
            }
        @@keyframes pjax-bar {
            from

        {
            background-position: 200% 0;
        }

        to {
            background-position: -200% 0;
        }

        }

        /* ========== 底部播放器样式 ========== */
        body {
            /* 给底部播放器留出空间，避免遮挡页面内容 */
            padding-bottom: 90px;
        }

        .player-footer {
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            height: 80px;
            background-color: #fff;
            border-top: 1px solid #e5e5e5;
            box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
            display: flex;
            align-items: center;
            padding: 0 20px;
            z-index: 1030; /* 高于普通内容 */
            font-size: 14px;
            color: #333;
        }

        .player-inner {
            display: flex;
            align-items: center;
            width: 100%;
            height: 100%;
        }

        /* 左侧：封面 + 歌曲信息 */
        .player-info {
            display: flex;
            align-items: center;
            width: 260px;
            flex-shrink: 0;
        }

        .player-cover {
            width: 48px;
            height: 48px;
            border-radius: 4px;
            background-color: #f0f0f0;
            background-size: cover;
            background-position: center;
            margin-right: 12px;
            flex-shrink: 0;
        }

        .player-meta {
            overflow: hidden;
        }

        .player-title {
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.4;
        }

        .player-artist {
            font-size: 12px;
            color: #888;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 中间：控制按钮 + 进度条 */
        .player-center {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0 20px;
        }

        .player-controls {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 6px;
        }

        .player-btn {
            background: none;
            border: none;
            font-size: 18px;
            color: #333;
            cursor: pointer;
            padding: 2px 6px;
            line-height: 1;
            transition: color 0.15s;
        }

            .player-btn:hover {
                color: #1b6ec2;
            }

        .player-btn-main {
            font-size: 26px;
        }

        .player-progress {
            display: flex;
            align-items: center;
            width: 100%;
            gap: 8px;
        }

        .player-time {
            font-size: 12px;
            color: #888;
            min-width: 40px;
            text-align: center;
        }

        /* 自定义 range 滑块 */
        .player-range {
            -webkit-appearance: none;
            appearance: none;
            flex: 1;
            height: 4px;
            border-radius: 2px;
            background: linear-gradient(to right, #1b6ec2 0%, #1b6ec2 var(--progress, 0%), #e0e0e0 var(--progress, 0%), #e0e0e0 100%);
            outline: none;
            cursor: pointer;
        }

            .player-range::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #1b6ec2;
                border: 2px solid #fff;
                box-shadow: 0 0 2px rgba(0, 0, 0, 0.3);
                cursor: pointer;
            }

            .player-range::-moz-range-thumb {
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #1b6ec2;
                border: 2px solid #fff;
                box-shadow: 0 0 2px rgba(0, 0, 0, 0.3);
                cursor: pointer;
            }

        /* 右侧：音量 */
        .player-right {
            display: flex;
            align-items: center;
            width: 140px;
            flex-shrink: 0;
            gap: 8px;
        }

        .player-btn-volume {
            font-size: 16px;
        }

        .player-range-volume {
            width: 80px;
            flex: none;
        }

        /* 移动端简单适配 */
        @@media (max-width: 768px) {
            .player-info {
                width: 140px;
            }

            .player-right {
                display: none;
            }

            .player-footer {
                padding: 0 10px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">MVCDtimu</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3" id="app-main">
            @RenderBody()
        </main>
    </div>

    <!-- ==================== 底部固定播放器 ==================== -->
    <footer class="player-footer">
        <vc:music-bar-footer></vc:music-bar-footer>
    </footer>
    <!-- ================== 底部固定播放器 END ================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- ==================== 播放器脚本 ==================== -->
    <!-- ==================== PJAX ==================== -->
    <script>
        (function () {
            /* ---------- 特性检测：老浏览器直接放弃，走原生的整页跳转 ---------- */
            if (!window.fetch || !window.history || !history.pushState || !window.DOMParser) {
                console.log('PJAX disabled: unsupported browser');
                return;
            }

            const MAIN_SEL   = '#app-main';
            const TIMEOUT_MS = 12000;

            let navigating = false;

            /* ---------- 判断一个 <a> 要不要走 PJAX ---------- */
            function shouldPjax(a) {
                if (!a || !a.href) return false;
                if (a.target && a.target !== '_self') return false;   // _blank / _parent...
                if (a.hasAttribute('download'))       return false;
                if (a.dataset && a.dataset.noPjax !== undefined) return false;

                const raw = a.getAttribute('href') || '';
                if (raw.startsWith('javascript:'))    return false;
                if (raw === '#' || raw === '')        return false;

                let url;
                try { url = new URL(a.href, location.href); } catch (e) { return false; }

                if (url.origin !== location.origin)   return false;   // 跨域

                // 同路径同 query、只有 hash 不同 → 走原生（浏览器会滚锚点）
                if (url.pathname === location.pathname && url.search === location.search) return false;

                // 静态资源不拦
                if (/\.(png|jpe?g|gif|webp|svg|ico|bmp|mp3|mp4|webm|ogg|wav|flac|pdf|zip|rar|css|js|map|woff2?|ttf|otf)$/i.test(url.pathname)) return false;

                // 明确要下文件的 Content-Type 拦不住，但至少堵住上面的常见扩展名
                return true;
            }

            /* ---------- 重新执行插入的 <script> ---------- */
            function runScripts(root) {
                // 先快照，避免边遍历边改动
                const old = Array.prototype.slice.call(root.querySelectorAll('script'));
                old.forEach(function (o) {
                    const s = document.createElement('script');
                    for (let i = 0; i < o.attributes.length; i++) {
                        const at = o.attributes[i];
                        s.setAttribute(at.name, at.value);
                    }
                    s.textContent = o.textContent;
                    o.parentNode.replaceChild(s, o);
                });
            }

            function setBusy(on) {
                document.documentElement.classList.toggle('is-navigating', on);
            }

            /* ---------- 核心：导航 ---------- */
            async function navigate(url, push) {
                if (navigating) return;
                navigating = true;
                setBusy(true);
                const t0 = Date.now();

                const ctl = ('AbortController' in window) ? new AbortController() : null;
                const timer = setTimeout(function () {
                    if (ctl) ctl.abort();
                }, TIMEOUT_MS);

                try {
                    const resp = await fetch(url, {
                        method: 'GET',
                        credentials: 'same-origin',
                        headers: {
                            'X-PJAX': '1',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: ctl ? ctl.signal : undefined
                    });

                    // 被服务端重定向到别的 URL（登录失效等）→ 直接整页跳
                    if (resp.redirected && new URL(resp.url).pathname !== new URL(url, location.href).pathname) {
                        location.href = resp.url;
                        return;
                    }

                    if (!resp.ok) {
                        // 4xx/5xx → 整页跳，让浏览器正常处理
                        console.warn('PJAX: HTTP ' + resp.status + ', fallback to full load');
                        location.href = url;
                        return;
                    }

                    const html = await resp.text();
                    const doc  = new DOMParser().parseFromString(html, 'text/html');

                    const newMain = doc.querySelector(MAIN_SEL);
                    const oldMain = document.querySelector(MAIN_SEL);

                    if (!newMain || !oldMain) {
                        // 目标页没有 #app-main（比如错误页）→ 整页跳
                        console.warn('PJAX: no ' + MAIN_SEL + ' in response, fallback');
                        location.href = url;
                        return;
                    }

                    // ---- 替换 ----
                    oldMain.replaceWith(newMain);

                    // ---- 更新标题 ----
                    const t = doc.querySelector('title');
                    if (t) document.title = t.textContent;

                    // ---- 历史记录 ----
                    if (push !== false) {
                        history.pushState({ pjax: Date.now() }, '', url);
                    }

                    // ---- 重新执行页面脚本 ----
                    runScripts(newMain);

                    // ---- 通知页面：新内容已就绪 ----
                    document.dispatchEvent(new CustomEvent('pjax:load', { detail: { url: url } }));
                    document.dispatchEvent(new CustomEvent('pjax:end',  { detail: { url: url } }));

                    // ---- 滚动 ----
                    const u = new URL(url, location.href);
                    if (u.hash) {
                        const el = document.querySelector(u.hash);
                        if (el) {
                            el.scrollIntoView();
                        } else {
                            window.scrollTo(0, 0);
                        }
                    } else {
                        window.scrollTo(0, 0);
                    }

                    if (window.console && console.debug) {
                        console.debug('PJAX done in ' + (Date.now() - t0) + 'ms:', url);
                    }
                } catch (e) {
                    if (e && e.name === 'AbortError') {
                        console.warn('PJAX: timeout, fallback to full load');
                    } else {
                        console.warn('PJAX failed, fallback:', e);
                    }
                    location.href = url;
                } finally {
                    clearTimeout(timer);
                    navigating = false;
                    setBusy(false);
                }
            }

            /* ---------- 点击拦截（事件委托，替换 <main> 也不用重绑） ---------- */
            document.addEventListener('click', function (e) {
                if (e.defaultPrevented) return;
                if (e.button !== 0) return;                             // 只处理左键
                if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // 让浏览器新标签打开

                const a = e.target.closest && e.target.closest('a');
                if (!shouldPjax(a)) return;

                e.preventDefault();
                navigate(a.href, true);
            });

            /* ---------- 前进/后退 ---------- */
            window.addEventListener('popstate', function () {
                navigate(location.href, false);
            });

            /* ---------- 派发 pjax:start（可选） ---------- */
            // 如果需要，可以在 navigate() 开头加：
            // document.dispatchEvent(new CustomEvent('pjax:start', { detail: { url } }));

            /* ---------- 对外暴露（调试/手动触发用） ---------- */
            window.MvPjax = {
                navigate: navigate,
                reload: function () { return navigate(location.href, false); },
                isBusy: function () { return navigating; }
            };

            console.log('PJAX ready');
        })();
    </script>
    <!-- ==================== PJAX END ==================== -->
    <script>
        (function () {
            const audio    = document.getElementById('audioPlayer');
            if (!audio) { console.warn('找不到 #audioPlayer'); return; }

            const btnPlay  = document.getElementById('btnPlay');
            const btnPrev  = document.getElementById('btnPrev');
            const btnNext  = document.getElementById('btnNext');
            const titleEl  = document.getElementById('songTitle');
            const artistEl = document.getElementById('songArtist');
            const coverEl  = document.getElementById('playerCover');
            const timeCur  = document.getElementById('timeCurrent');
            const timeTot  = document.getElementById('timeTotal');
            const prog     = document.getElementById('progressRange');
            const btnMute  = document.getElementById('btnMute');
            const vol      = document.getElementById('volumeRange');

            let queue   = [];
            let index   = -1;
            let seeking = false;

            function fmt(s) {
                if (!isFinite(s) || s < 0) return '00:00';
                s = Math.floor(s);
                return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
            }
            function currentItem() { return queue[index] || null; }

            /* 更新 range 的渐变填充（和 CSS 里 var(--progress) 配合） */
            function setFill(el, percent) {
                if (!el) return;
                percent = Math.max(0, Math.min(100, percent));
                el.style.setProperty('--progress', percent + '%');
            }

            function emit(playingOverride) {
                const it = currentItem();
                const playing = typeof playingOverride === 'boolean' ? playingOverride : !audio.paused;
                document.dispatchEvent(new CustomEvent('player:change', {
                    detail: { hash: it ? it.hash : null, playing: playing }
                }));
            }

            function updateUI() {
                const it = currentItem();
                if (titleEl)  titleEl.textContent  = it ? it.title  : '歌曲名称';
                if (artistEl) artistEl.textContent = it ? (it.artist || '') : '歌手';
                if (coverEl) {
                    if (it && it.cover) {
                        coverEl.style.backgroundImage = 'url("' + String(it.cover).replace(/"/g, '\\"') + '")';
                    } else {
                        coverEl.style.backgroundImage = '';
                    }
                }
                if (btnPlay) btnPlay.textContent = audio.paused ? '▶' : '⏸';
                emit();
            }

            function load(i, autoplay) {
                if (i < 0 || i >= queue.length) return;
                index = i;
                const it = queue[i];
                audio.src = it.url;
                audio.load();
                updateUI();
                if (autoplay !== false) {
                    emit(true);                       // 乐观：先把按钮切成暂停
                    audio.play().catch(function () {  // 被自动播放策略拦下
                        emit(false);
                    });
                }
            }

            /* ---------- 控制按钮 ---------- */
            if (btnPlay) {
                btnPlay.addEventListener('click', function () {
                    if (!audio.src) { if (queue.length) load(0, true); return; }
                    if (audio.paused) audio.play().catch(function () {});
                    else audio.pause();
                });
            }
            if (btnPrev) {
                btnPrev.addEventListener('click', function () {
                    if (!queue.length) return;
                    load(index > 0 ? index - 1 : queue.length - 1, true);
                });
            }
            if (btnNext) {
                btnNext.addEventListener('click', function () {
                    if (!queue.length) return;
                    load(index < queue.length - 1 ? index + 1 : 0, true);
                });
            }

            /* ---------- audio 事件 ---------- */
            audio.addEventListener('play',  updateUI);
            audio.addEventListener('pause', updateUI);
            audio.addEventListener('ended', function () {
                if (index < queue.length - 1) load(index + 1, true);
                else updateUI();
            });
            audio.addEventListener('loadedmetadata', function () {
                if (timeTot) timeTot.textContent = fmt(audio.duration);
                if (prog) {
                    prog.max = isFinite(audio.duration) ? audio.duration : 100;
                    setFill(prog, 0);
                }
            });
            audio.addEventListener('timeupdate', function () {
                if (seeking) return;
                if (timeCur) timeCur.textContent = fmt(audio.currentTime);
                if (prog) {
                    prog.value = audio.currentTime;
                    const max = parseFloat(prog.max) || audio.duration || 0;
                    if (max > 0) setFill(prog, (audio.currentTime / max) * 100);
                }
            });

            /* ---------- 进度条 ---------- */
            if (prog) {
                prog.addEventListener('input', function () {
                    seeking = true;
                    if (timeCur) timeCur.textContent = fmt(parseFloat(prog.value));
                    const max = parseFloat(prog.max) || 1;
                    setFill(prog, (parseFloat(prog.value) / max) * 100);
                });
                prog.addEventListener('change', function () {
                    audio.currentTime = parseFloat(prog.value) || 0;
                    seeking = false;
                });
            }

            /* ---------- 音量 ---------- */
            if (vol) {
                // 初始化（音量条是 0-100 的整数范围）
                vol.value = Math.round((audio.volume || 0.8) * 100);
                audio.volume = vol.value / 100;
                setFill(vol, vol.value);

                vol.addEventListener('input', function () {
                    audio.volume = vol.value / 100;
                    audio.muted  = audio.volume === 0;
                    if (btnMute) {
                        btnMute.textContent = audio.muted ? '🔇' : '🔊';
                        btnMute.title = audio.muted ? '取消静音' : '静音';
                    }
                    setFill(vol, vol.value);
                });
            }
            if (btnMute) {
                btnMute.addEventListener('click', function () {
                    audio.muted = !audio.muted;
                    btnMute.textContent = audio.muted ? '🔇' : '🔊';
                    btnMute.title = audio.muted ? '取消静音' : '静音';
                });
            }

            /* ---------- 对外接口 ---------- */
            window.MvPlayer = {
                /**
                 * 播放整个队列（从第 i 首开始）
                 * @@param {Array<{hash:string,url:string,title:string,artist:string,cover?:string}>} list
                 * @@param {number} i
                 */
                playQueue: function (list, i) {
                    queue = Array.isArray(list) ? list.slice() : [];
                    i = i || 0;
                    const it = queue[i];
                    if (!it) return;
                    const cur = currentItem();
                    if (cur && cur.hash === it.hash) {
                        // 同一首 → 切换播放/暂停
                        if (audio.paused) audio.play().catch(function () {});
                        else audio.pause();
                        return;
                    }
                    load(i, true);
                },
                toggle: function () {
                    if (audio.paused) audio.play().catch(function () {});
                    else audio.pause();
                },
                next: function () { if (btnNext) btnNext.click(); },
                prev: function () { if (btnPrev) btnPrev.click(); },
                current: function () { return currentItem(); },
                refresh: function () { updateUI(); }
            };
        })();
    </script>
    <!-- ==================== 播放器脚本 END ==================== -->
</body>
</html>