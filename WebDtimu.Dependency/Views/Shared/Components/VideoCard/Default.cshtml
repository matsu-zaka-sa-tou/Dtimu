@* WebDtimu.Dependency\Views\Shared\Components\VedioCard\ *@

@{
    var guid = Guid.NewGuid().ToString("N");

    bool isSquareMode = ViewData["AppId431960Mode"] as bool? ?? false;
    bool isBurned = ViewData["IsBurned"] as bool? ?? true;

    int itemWidth = 160;
    int imgHeight = isSquareMode ? 160 : 90;

    string cardCss = "width: " + itemWidth + "px;";
    string imgWrapperCss = "height: " + imgHeight + "px;";
}
<style>
    /* ★ 覆盖全局绝对定位，让背景和内容自然撑开 */
    .card-base-@(guid) .card-chrome {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        height: auto !important;
        background-color: #D6D9E8;
        padding-top: 10px;
        padding-bottom: 20px;
    }

    .card-base-@(guid) .card-title {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        margin-left: 20px;
        margin-bottom: 10px;
        font-weight: 900;
    }

    .card-base-@(guid) {
        position: relative;
        margin-bottom: 20px;
        height: auto !important;
    }

    /* ===== 视图切换按钮（右上角） ===== */
    .view-toolbar-@guid {
        position: absolute;
        top: 10px;
        right: 20px;
        z-index: 10;
        display: flex;           /* Firefox 28+ */
    }

    .view-btn-@guid {
        width: 32px;
        height: 28px;
        padding: 0;
        margin-left: 6px;        /* 替代 gap */
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
        display: inline-block;
        line-height: 26px;
        text-align: center;
        font-size: 14px;
        color: #333;
        box-sizing: border-box;
    }

    .view-btn-@(guid):first-child { margin-left: 0; }
    .view-btn-@(guid):hover { background: #f0f0f0; }
    .view-btn-@(guid).active {
        background: #3b82f6;
        color: #fff;
        border-color: #3b82f6;
    }

    /* ===== 大图标模式（基础，flex 布局，替代 grid） ===== */
    .video-grid-@(guid) {
        display: flex;
        flex-wrap: wrap;
        margin-left: 20px;
    }

    .video-card-content-@(guid) {
        @Html.Raw(cardCss)
        margin: 0 20px 20px 0;   /* 替代 gap */
        overflow: hidden;
        background-color: #f0f0f0;
        display: flex;
        flex-direction: column;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        cursor: pointer;
        box-sizing: border-box;
    }

    .video-card-content-@(guid):hover {
        transform: translateY(-2px);
    }

    .img-wrapper-@(guid) {
        width: 100%;
        @Html.Raw(imgWrapperCss)
        overflow: hidden;
        flex-shrink: 0;
    }

    .video-card-content-@(guid) img {
        width: 100% !important;
        height: 100% !important;
        object-fit: cover;
        display: block;
    }

    .title-bar-@(guid) {
        width: 100%;
        height: 28px;
        line-height: 28px;
        background-color: #333333;
        color: #ffffff;
        font-size: 12px;
        text-align: center;
        padding: 0 8px;
        box-sizing: border-box;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ===== 平铺列表模式 ===== */
    .video-grid-@(guid).mode-list {
        display: flex !important;
        flex-wrap: wrap;
        margin: 0 20px;
    }

    .video-grid-@(guid).mode-list .video-card-content-@(guid) {
        width: 100%;
        flex: 1 1 100%;
        min-height: 86px;
        height: auto;
        display: flex;
        flex-direction: row;
        align-items: center;
        padding: 10px;
        margin: 0 0 15px 0;
        background: #f8f9fa;
        border: 1px solid #eee;
        border-radius: 6px;
        cursor: pointer;
        box-sizing: border-box;
        overflow: hidden;
    }

    .video-grid-@(guid).mode-list .video-card-content-@(guid):hover {
        background: #f0f2f5;
    }

    .video-grid-@(guid).mode-list .video-card-content-@(guid) img {
        width: 100px !important;
        height: 64px !important;
        flex-shrink: 0;
        object-fit: cover;
        border-radius: 4px;
        margin-right: 12px;      /* 替代 gap */
    }

    .item-title-@(guid) {
        font-size: 14px;
        color: #333;
        line-height: 21px;       /* 1.5 × 14 */
        height: 63px;            /* 3 行固定高度，替代 -webkit-line-clamp */
        overflow: hidden;
        word-break: break-all;
        flex: 1;
        min-width: 0;
    }

    /* ===== 详细信息模式 ===== */
    .video-grid-@(guid).mode-detail {
        display: block !important;
        margin: 0 20px;
    }

    .video-grid-@(guid).mode-detail ol {
        padding-left: 24px;
        padding-right: 20px;
        margin: 0;
    }

    .video-grid-@(guid).mode-detail li {
        margin-bottom: 12px;
        border-bottom: 1px solid rgba(0,0,0,0.1);
        padding-bottom: 12px;
    }

    /* ===== 小屏适配（240 / 320 / 360 px） ===== */
    @@media (max-width: 360px) {
        .card-base-@(guid) .card-title {
            margin-left: 8px;
            font-size: 14px;
        }

        .view-toolbar-@(guid) {
            top: 8px;
            right: 8px;
        }

        .view-btn-@(guid) {
            width: 26px;
            height: 24px;
            line-height: 22px;
            font-size: 12px;
            margin-left: 4px;
        }

        .video-grid-@(guid) {
            margin-left: 8px;
        }

        /* 只在大图标模式缩小卡片，避免影响列表/详细模式 */
        .video-grid-@(guid):not(.mode-list):not(.mode-detail) .video-card-content-@(guid) {
            width: 120px;
            margin: 0 8px 8px 0;
        }

        .video-grid-@(guid):not(.mode-list):not(.mode-detail) .img-wrapper-@(guid) {
            height: 68px;
        }

        .title-bar-@(guid) {
            height: 22px;
            line-height: 22px;
            font-size: 11px;
        }

        .video-grid-@(guid).mode-list {
            margin: 0 8px;
        }

        .video-grid-@(guid).mode-list .video-card-content-@(guid) {
            padding: 8px;
            min-height: 70px;
            margin-bottom: 10px;
        }

        .video-grid-@(guid).mode-list .video-card-content-@(guid) img {
            width: 72px !important;
            height: 46px !important;
            margin-right: 8px;
        }

        .item-title-@(guid) {
            font-size: 12px;
            line-height: 18px;
            height: 54px;
        }

        .video-grid-@(guid).mode-detail {
            margin: 0 8px;
        }

        .video-grid-@(guid).mode-detail ol {
            padding-left: 16px;
            padding-right: 8px;
        }

        /* 低端设备禁动画 */
        .video-card-content-@(guid) { transition: none; }
        .video-card-content-@(guid):hover { transform: none; }
    }
</style>

<div class="card-base-@(guid)" id="@guid">
    <div class="card-chrome">
        <div class="view-toolbar-@guid">
            <button type="button" class="view-btn-@guid active" data-mode="grid" title="大图标">▦</button>
            <button type="button" class="view-btn-@guid" data-mode="list" title="平铺列表">☰</button>
            <button type="button" class="view-btn-@guid" data-mode="detail" title="详细信息">≣</button>
        </div>
        <h6 class="card-title">视频</h6>
        <div class="video-grid-@guid"></div>
    </div>
</div>

<script>
    (function () {
        var IS_BURNED = @(isBurned.ToString().ToLower());
        var currentMode = 'grid';
        var videosData = [];

        function findAncestor(el, className) {
            while (el && el.nodeType === 1) {
                if (el.className && (' ' + el.className + ' ').indexOf(' ' + className + ' ') !== -1) {
                    return el;
                }
                el = el.parentNode;
            }
            return null;
        }

        function getJson(url, onOk, onErr) {
            var xhr;
            try {
                xhr = new XMLHttpRequest();
            } catch (e) {
                onErr(new Error('XMLHttpRequest 不可用'));
                return;
            }
            xhr.open('GET', url, true);
            xhr.onreadystatechange = function () {
                if (xhr.readyState !== 4) return;
                if (xhr.status >= 200 && xhr.status < 300) {
                    var data;
                    try {
                        data = JSON.parse(xhr.responseText);
                    } catch (e) {
                        onErr(e);
                        return;
                    }
                    onOk(data);
                } else {
                    onErr(new Error('HTTP ' + xhr.status));
                }
            };
            xhr.onerror = function () { onErr(new Error('网络错误')); };
            xhr.send();
        }

        function makeClickHandler(vid) {
            return function () {
                window.location.href = '/Video/Detail/' + encodeURIComponent(vid);
            };
        }

        function init() {
            var cardBase = document.getElementById('@guid');
            if (!cardBase) return;

            var grid = cardBase.querySelector('.video-grid-@guid');
            var toolbar = cardBase.querySelector('.view-toolbar-@guid');

            toolbar.addEventListener('click', function (e) {
                var btn = findAncestor(e.target, 'view-btn-@guid');
                if (!btn) return;

                var btns = toolbar.querySelectorAll('.view-btn-@guid');
                for (var i = 0; i < btns.length; i++) {
                    btns[i].className = btns[i].className.replace(/\bactive\b/g, '').replace(/\s+/g, ' ').replace(/^\s+|\s+$/g, '');
                }
                btn.className = btn.className + ' active';

                currentMode = btn.getAttribute('data-mode') || 'grid';
                render();
            });

            getJson('/api/Lists/VideoList', function (videosDict) {
                videosData = [];
                for (var id in videosDict) {
                    if (Object.prototype.hasOwnProperty.call(videosDict, id)) {
                        videosData.push({ id: id, data: videosDict[id] });
                    }
                }
                render();
            }, function (err) {
                while (grid.firstChild) grid.removeChild(grid.firstChild);
                var errDiv = document.createElement('div');
                errDiv.style.color = '#c00';
                errDiv.style.padding = '10px 20px';
                errDiv.textContent = '加载视频失败：' + (err && err.message ? err.message : err);
                grid.appendChild(errDiv);
            });

            function render() {
                grid.className = 'video-grid-@guid' + (currentMode === 'grid' ? '' : ' mode-' + currentMode);
                while (grid.firstChild) grid.removeChild(grid.firstChild);

                if (currentMode === 'detail') {
                    renderDetail(grid);
                } else {
                    renderCards(grid);
                }
            }

            function renderCards(container) {
                for (var i = 0; i < videosData.length; i++) {
                    var item = videosData[i];
                    var id = item.id;
                    var data = item.data;

                    var div = document.createElement('div');
                    div.className = 'video-card-content-@guid';
                    div.onclick = makeClickHandler(id);

                    var sources = [];
                    if (!IS_BURNED) {
                        if (id) sources.push('/api/AppId431960Mode?id=' + encodeURIComponent(id));
                    } else {
                        if (data.gallery && data.gallery.length > 0) {
                            for (var g = 0; g < data.gallery.length; g++) {
                                sources.push('data:image/png;base64,' + data.gallery[g]);
                            }
                        }
                    }
                    if (sources.length === 0) sources.push('/images/default-cover.png');

                    var img = document.createElement('img');
                    img.src = sources[0];
                    img.alt = data.title || '视频';
                    img.onerror = function () {
                        this.onerror = null;
                        this.src = '/images/default-cover.png';
                    };

                    var titleText = data.title || '未命名视频';

                    if (currentMode === 'list') {
                        div.appendChild(img);

                        var title = document.createElement('div');
                        title.className = 'item-title-@guid';
                        title.textContent = titleText;
                        title.title = titleText;
                        div.appendChild(title);
                    } else {
                        var imgWrapper = document.createElement('div');
                        imgWrapper.className = 'img-wrapper-@guid';
                        imgWrapper.appendChild(img);
                        div.appendChild(imgWrapper);

                        var titleBar = document.createElement('div');
                        titleBar.className = 'title-bar-@guid';
                        titleBar.textContent = titleText;
                        titleBar.title = titleText;
                        div.appendChild(titleBar);
                    }

                    container.appendChild(div);
                }
            }

            function renderDetail(container) {
                var ol = document.createElement('ol');

                for (var i = 0; i < videosData.length; i++) {
                    var item = videosData[i];
                    var id = item.id;
                    var data = item.data;

                    var li = document.createElement('li');

                    var a = document.createElement('a');
                    a.href = '/Video/Detail/' + encodeURIComponent(id);
                    a.style.color = '#1a73e8';
                    a.style.textDecoration = 'none';
                    a.style.fontSize = '15px';
                    a.style.fontWeight = 'bold';
                    a.textContent = data.title || '未命名视频';
                    li.appendChild(a);

                    var meta = document.createElement('div');
                    meta.style.fontSize = '13px';
                    meta.style.color = '#666';
                    meta.style.marginTop = '6px';

                    var metaText = 'ID: ' + id + ' | 作者: ' + (data.author || '未知');
                    if (data.duration && typeof data.duration === 'string') {
                        metaText += ' | 时长: ' + data.duration.split('.')[0];
                    }
                    if (data.tags && data.tags.join) {
                        metaText += ' | 标签: ' + data.tags.join(', ');
                    }

                    meta.textContent = metaText;
                    li.appendChild(meta);
                    ol.appendChild(li);
                }
                container.appendChild(ol);
            }
        }

        init();
    })();
</script>