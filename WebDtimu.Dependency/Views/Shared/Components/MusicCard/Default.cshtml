@* WebDtimu.Dependency\Views\Shared\Components\MusicCard\ *@

@{
    var guid = Guid.NewGuid().ToString();
}

<style>
    .album-grid {
        display: grid;
        grid-auto-rows: 120px;
        gap: 0px;
    }

    .album-item img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        cursor: pointer;
        display: block;
    }

    .album-text {
        width: 120px;
        height: 120px;
        color: white;
        font-size: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        cursor: pointer;
    }

    .preview-box {
        position: fixed;
        width: 200px;
        height: 200px;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        display: none;
        pointer-events: none;
        z-index: 999;
        background-color: black;
        opacity: 0;
        transition: opacity 0.12s ease-out;
    }

        .preview-box.show {
            display: block;
            opacity: 1;
        }

        .preview-box.hide {
            opacity: 0;
        }

        .preview-box img,
        .preview-box .preview-text {
            width: 100%;
            height: 100%;
            object-fit: cover;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 18px;
            text-align: center;
            padding: 5px;
        }

    .card-combined-base {
        position: relative;
        padding-top: 40px;
        margin-bottom: 40px;
    }
</style>

<div class="card-combined-base" id="@guid">
    <div class="card-chrome">
        <h6 class="card-title">音乐</h6>
        <div class="album-grid" style="margin-top:40px;margin-left:40px"></div>
        <div id="previewBox" class="preview-box"></div>
    </div>
</div>

<script>
    (() => {
        async function init() {
            const cardBase = document.getElementById('@guid');
            if (!cardBase) return;

            const Size = 120;
            const PREW = 200, PREH = 200;

            const chrome = cardBase.querySelector('.card-chrome');
            const albumGrid = chrome.querySelector('.album-grid');
            const preview = chrome.querySelector('.preview-box');

            /* ★ 全局封面工具：由 _Layout.cshtml 提供 */
            if (!window.CoverUtil) {
                chrome.textContent = '封面工具未加载：请检查 _Layout.cshtml 里的 CoverUtil 脚本';
                console.error('window.CoverUtil 不存在');
                return;
            }

            let albumsDict;
            try {
                albumsDict = await fetch('/api/Lists/AlumbList').then(r => r.json());
            } catch (e) {
                chrome.textContent = '加载音乐失败：' + e.message;
                console.error(e);
                return;
            }

            const albumsInfo = Object.entries(albumsDict).map(([key, value]) => ({
                key, ...value
            }));

            /* ★ 缓存与生成全部交给 CoverUtil */
            function coverUrl(item) {
                return window.CoverUtil.coverUrl(item);
            }

            function updateGridColumns() {
                const containerWidth = albumGrid.clientWidth;
                const cols = Math.max(1, Math.floor(containerWidth / Size));
                albumGrid.style.gridTemplateColumns = `repeat(${cols}, ${Size}px)`;
                return cols;
            }

            albumGrid.innerHTML = '';

            albumsInfo.forEach((item) => {
                const el = document.createElement("div");
                el.classList.add("album-item");
                el.style.width = Size + "px";
                el.style.height = Size + "px";

                const img = document.createElement("img");
                img.src = coverUrl(item);
                img.alt = item.key;
                img.loading = "lazy";
                el.appendChild(img);

                albumGrid.appendChild(el);

                function showPreview(e) {
                    preview.style.display = "block";
                    preview.innerHTML = `<img src="${coverUrl(item)}" alt="" />`;

                    const rect = el.getBoundingClientRect();

                    let left = rect.left + rect.width / 2 - PREW / 2;
                    let top  = rect.top  + rect.height / 2 - PREH / 2;

                    preview.style.left = left + "px";
                    preview.style.top  = top  + "px";

                    preview.classList.add("show");
                    preview.classList.remove("hide");
                }

                function hidePreview() {
                    preview.classList.remove("show");
                    preview.classList.add("hide");
                    clearTimeout(preview._hideTimer);
                    preview._hideTimer = setTimeout(() => {
                        if (preview.classList.contains("show")) return;
                        preview.style.display = "none";
                    }, 150);
                }

                el.addEventListener("mouseenter", showPreview);
                el.addEventListener("mousemove", showPreview);
                el.addEventListener("mouseleave", hidePreview);

                /* ★ 关键：点击必须走 PJAX，不能直接 location.href 硬跳 */
                el.addEventListener("click", (e) => {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

                    const url = "/Album/Detail?name=" + encodeURIComponent(item.key);

                    if (window.MvPjax && typeof window.MvPjax.navigate === 'function') {
                        e.preventDefault();
                        window.MvPjax.navigate(url, true);
                    } else {
                        location.href = url;
                    }
                });
            });

            function updateContainerHeight() {
                const cols = updateGridColumns();
                const rows = Math.ceil(albumGrid.children.length / cols);
                const outres = rows * Size;
                cardBase.style.height = outres + "px";
                chrome.style.height = outres + "px";
            }

            updateContainerHeight();

            let resizeTimer;
            window.addEventListener("resize", () => {
                if (!document.contains(cardBase)) return;
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateContainerHeight, 100);
            });
        }

        init();
    })();
</script>