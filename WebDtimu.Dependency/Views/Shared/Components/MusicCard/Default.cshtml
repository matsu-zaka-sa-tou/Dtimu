@* WebDtimu.Dependency\Views\Shared\Components\MusicCard\ *@

@{
    var guid = Guid.NewGuid().ToString();
}

<style>
    /* ★ 核心修复：干掉绝对定位 */
    .card-combined-base-@(guid) .card-chrome {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        height: auto !important;
        background-color: #D6D9E8;
        padding-top: 10px;
        padding-bottom: 20px;
    }

    .card-combined-base-@(guid) .card-title {
        position: relative !important;
        top: auto !important;
        left: auto !important;
        margin-left: 20px;
        margin-bottom: 10px;
        font-weight: 900;
    }

    .card-combined-base-@(guid) {
        position: relative;
        margin-bottom: 20px;
        height: auto !important;
    }

    .album-grid-@(guid) {
        display: grid;
        grid-template-columns: repeat(auto-fill, 120px); /* 纯CSS自适应网格 */
        gap: 10px; /* 加点间隙更好看 */
        margin-left: 20px;
    }

    .album-item-@(guid) img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        cursor: pointer;
        display: block;
        border-radius: 4px;
    }

    .preview-box-@(guid) {
        position: fixed;
        width: 200px;
        height: 200px;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        display: none;
        pointer-events: none;
        z-index: 999;
        background-color: black;
        opacity: 0;
        transition: opacity 0.12s ease-out;
    }

    .preview-box-@(guid).show { display: block; opacity: 1; }
    .preview-box-@(guid).hide { opacity: 0; }

    .preview-box-@(guid) img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
</style>

<div class="card-combined-base-@(guid)" id="@guid">
    <div class="card-chrome">
        <h6 class="card-title">音乐</h6>
        <div class="album-grid-@(guid)"></div>
        <div id="previewBox-@(guid)" class="preview-box-@(guid)"></div>
    </div>
</div>

<script>
    (() => {
        async function init() {
            const cardBase = document.getElementById('@guid');
            if (!cardBase) return;

            const albumGrid = cardBase.querySelector('.album-grid-@(guid)');
            const preview = cardBase.querySelector('.preview-box-@(guid)');

            if (!window.CoverUtil) {
                console.error('window.CoverUtil 不存在');
                return;
            }

            let albumsDict;
            try {
                albumsDict = await fetch('/api/Lists/AlumbList').then(r => r.json());
            } catch (e) {
                console.error(e);
                return;
            }

            const albumsInfo = Object.entries(albumsDict).map(([key, value]) => ({ key, ...value }));

            function coverUrl(item) { return window.CoverUtil.coverUrl(item); }

            albumGrid.innerHTML = '';

            albumsInfo.forEach((item) => {
                const el = document.createElement("div");
                el.classList.add("album-item-@(guid)");

                const img = document.createElement("img");
                img.src = coverUrl(item);
                img.alt = item.key;
                img.loading = "lazy";
                el.appendChild(img);

                albumGrid.appendChild(el);

                function showPreview(e) {
                    preview.style.display = "block";
                    preview.innerHTML = `<img src="${coverUrl(item)}" alt="" />`;

                    const rect = el.getBoundingClientRect();
                    preview.style.left = (rect.left + rect.width / 2 - 100) + "px";
                    preview.style.top  = (rect.top  + rect.height / 2 - 100) + "px";

                    preview.classList.add("show");
                    preview.classList.remove("hide");
                }

                function hidePreview() {
                    preview.classList.remove("show");
                    preview.classList.add("hide");
                    clearTimeout(preview._hideTimer);
                    preview._hideTimer = setTimeout(() => {
                        if (preview.classList.contains("show")) return;
                        preview.style.display = "none";
                    }, 150);
                }

                el.addEventListener("mouseenter", showPreview);
                el.addEventListener("mousemove", showPreview);
                el.addEventListener("mouseleave", hidePreview);

                el.addEventListener("click", (e) => {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0) return;
                    const url = "/Album/Detail?name=" + encodeURIComponent(item.key);
                    if (window.MvPjax) {
                        e.preventDefault();
                        window.MvPjax.navigate(url, true);
                    } else {
                        location.href = url;
                    }
                });
            });
            
            // ★ 彻底去掉了原本在这里的 updateContainerHeight 计算高度的代码
        }

        init();
    })();
</script>