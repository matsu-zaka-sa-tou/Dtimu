@* WebDtimu.Dependency\Views\Shared\Components\MusicCard\ *@

@{
    var guid = Guid.NewGuid().ToString();
}

<style>
    .album-grid {
        display: grid;
        grid-auto-rows: 120px;
        gap: 0px;
    }

    .album-item img {
        width: 120px;
        height: 120px;
        object-fit: cover;
        cursor: pointer;
        display: block;
    }

    .album-text {
        width: 120px;
        height: 120px;
        color: white;
        font-size: 18px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        cursor: pointer;
    }

    .preview-box {
        position: fixed;
        width: 200px;
        height: 200px;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.7);
        display: none;
        pointer-events: none;
        z-index: 999;
        background-color: black;
        opacity: 0;
        transition: opacity 0.12s ease-out;
    }

        .preview-box.show {
            display: block;
            opacity: 1;
        }

        .preview-box.hide {
            opacity: 0;
        }

        .preview-box img,
        .preview-box .preview-text {
            width: 100%;
            height: 100%;
            object-fit: cover;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 18px;
            text-align: center;
            padding: 5px;
        }

    .card-combined-base {
        position: relative;
        padding-top: 40px;
        margin-bottom: 40px;
    }
</style>

<div class="card-combined-base" id="@guid">
    <div class="card-chrome">
        <h6 class="card-title">音乐</h6>
        <div class="album-grid" style="margin-top:40px;margin-left:40px"></div>
        <div id="previewBox" class="preview-box"></div>
    </div>
</div>

<script>
    // —— 与 WebDtimu.Dependency.TextCoverUtil 视觉同步的前端 SVG 封面 ——
    (function () {
        const COLORS = [
            [49, 91, 37], [31, 78, 64], [39, 67, 105], [54, 75, 94],
            [72, 52, 91], [95, 49, 78], [106, 47, 52], [113, 56, 48],
            [92, 67, 45], [61, 66, 70], [34, 81, 84], [50, 58, 102],
            [76, 85, 42], [82, 60, 53]
        ];

        const FONT = '"Microsoft YaHei UI","Microsoft YaHei","Segoe UI",Arial,sans-serif';
        const W = 420, H = 420;
        const LEFT = 22, BOTTOM = 18;
        const NAME_MAX_W = 220, NAME_MAX_H = 165;
        const BIG_FONT = 300;

        let _ctx = null;
        function ctx() {
            if (!_ctx) _ctx = document.createElement('canvas').getContext('2d');
            return _ctx;
        }

        function pickColor(text) {
            let h = 2166136261 >>> 0;
            for (const ch of (text || '')) {
                h ^= ch.codePointAt(0);
                h = Math.imul(h, 16777619) >>> 0;
            }
            const c = COLORS[h % COLORS.length];
            return `rgb(${c[0]},${c[1]},${c[2]})`;
        }

        function firstElement(text) {
            text = (text || '').trim();
            if (!text) return '?';
            if (window.Intl && Intl.Segmenter) {
                const seg = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
                for (const s of seg.segment(text)) return s.segment.toUpperCase();
            }
            return Array.from(text)[0].toUpperCase();
        }

        function wrap(c, text, maxW) {
            const lines = [];
            let cur = '';
            for (const ch of text) {
                const t = cur + ch;
                if (c.measureText(t).width > maxW && cur) {
                    lines.push(cur);
                    cur = ch;
                } else {
                    cur = t;
                }
            }
            if (cur) lines.push(cur);
            return lines.length ? lines : [''];
        }

        function esc(s) {
            return String(s).replace(/[<>&"']/g, ch => ({
                '<': '&lt;', '>': '&gt;', '&': '&amp;',
                '"': '&quot;', "'": '&apos;'
            }[ch]));
        }

        function generateCoverSvg(text) {
            text = (text || '').trim() || '?';
            const c = ctx();

            const big = firstElement(text);
            c.font = `bold ${BIG_FONT}px ${FONT}`;
            const bm = c.measureText(big);

            const bAsc = bm.actualBoundingBoxAscent || BIG_FONT * 0.85;
            const bDesc = bm.actualBoundingBoxDescent || BIG_FONT * 0.15;
            const bW = bm.width || BIG_FONT;
            const bH = bAsc + bDesc;

            const bigLeft = W - bW * 0.68;
            const bigTop  = H - bH * 0.72;
            const bigBase = bigTop + bAsc;

            let fontSize = 25, lines = [text], lineH = 25 * 1.25, lineAsc = 25 * 0.85;
            for (let s = 25; s >= 15; s--) {
                c.font = `${s}px ${FONT}`;
                const ln = wrap(c, text, NAME_MAX_W);
                const lh = s * 1.25;
                if (ln.length * lh <= NAME_MAX_H || s === 15) {
                    fontSize = s;
                    lines = ln;
                    lineH = lh;
                    const m = c.measureText('中');
                    lineAsc = m.actualBoundingBoxAscent || s * 0.85;
                    break;
                }
            }

            const blockH   = lines.length * lineH;
            const blockTop = H - BOTTOM - blockH;

            const tspans = lines.map((line, i) =>
                `<tspan x="${LEFT}" y="${(blockTop + i * lineH + lineAsc).toFixed(2)}">${esc(line)}</tspan>`
            ).join('');

            const bg = pickColor(text);

            return `<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">`
                + `<rect width="${W}" height="${H}" fill="${bg}"/>`
                + `<text x="${bigLeft.toFixed(2)}" y="${bigBase.toFixed(2)}" `
                + `font-family='${FONT}' font-size="${BIG_FONT}" font-weight="bold" fill="#fff">`
                + esc(big)
                + `</text>`
                + `<text font-family='${FONT}' font-size="${fontSize}" fill="#fff">`
                + tspans
                + `</text>`
                + `</svg>`;
        }

        function coverSvgDataUrl(text) {
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(generateCoverSvg(text));
        }

        window.generateCoverSvg = generateCoverSvg;
        window.coverSvgDataUrl  = coverSvgDataUrl;
    })();
</script>

<script>
    (() => {
        async function init() {
            const cardBase = document.getElementById('@guid');
            if (!cardBase) return;

            const Size = 120;
            const PREW = 200, PREH = 200;

            const chrome = cardBase.querySelector('.card-chrome');
            const albumGrid = chrome.querySelector('.album-grid');
            const preview = chrome.querySelector('.preview-box');

            let albumsDict;
            try {
                albumsDict = await fetch('/api/Lists/AlumbList').then(r => r.json());
            } catch (e) {
                chrome.textContent = '加载音乐失败：' + e.message;
                console.error(e);
                return;
            }

            const albumsInfo = Object.entries(albumsDict).map(([key, value]) => ({
                key, ...value
            }));

            const _svgCache = new Map();

            function coverUrl(item) {
                if (item.pictures && item.pictures.length) {
                    return '/Cover/' + encodeURIComponent(item.pictures[0]);
                }
                let url = _svgCache.get(item.key);
                if (!url) {
                    url = coverSvgDataUrl(item.key);
                    _svgCache.set(item.key, url);
                }
                return url;
            }

            function updateGridColumns() {
                const containerWidth = albumGrid.clientWidth;
                const cols = Math.max(1, Math.floor(containerWidth / Size));
                albumGrid.style.gridTemplateColumns = `repeat(${cols}, ${Size}px)`;
                return cols;
            }

            albumGrid.innerHTML = '';

            albumsInfo.forEach((item) => {
                const el = document.createElement("div");
                el.classList.add("album-item");
                el.style.width = Size + "px";
                el.style.height = Size + "px";

                const img = document.createElement("img");
                img.src = coverUrl(item);
                img.alt = item.key;
                img.loading = "lazy";
                el.appendChild(img);

                albumGrid.appendChild(el);

                function showPreview(e) {
                    preview.style.display = "block";
                    preview.innerHTML = `<img src="${coverUrl(item)}" alt="" />`;

                    const rect = el.getBoundingClientRect();

                    let left = rect.left + rect.width / 2 - PREW / 2;
                    let top  = rect.top  + rect.height / 2 - PREH / 2;

                    preview.style.left = left + "px";
                    preview.style.top  = top  + "px";

                    preview.classList.add("show");
                    preview.classList.remove("hide");
                }

                function hidePreview() {
                    preview.classList.remove("show");
                    preview.classList.add("hide");
                    clearTimeout(preview._hideTimer);
                    preview._hideTimer = setTimeout(() => {
                        if (preview.classList.contains("show")) return;
                        preview.style.display = "none";
                    }, 150);
                }

                el.addEventListener("mouseenter", showPreview);
                el.addEventListener("mousemove", showPreview);
                el.addEventListener("mouseleave", hidePreview);

                /* ★ 关键：点击必须走 PJAX，不能直接 location.href 硬跳 */
                el.addEventListener("click", (e) => {
                    if (e.defaultPrevented) return;
                    if (e.button !== 0) return;
                    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

                    const url = "/Album/Detail?name=" + encodeURIComponent(item.key);

                    if (window.MvPjax && typeof window.MvPjax.navigate === 'function') {
                        e.preventDefault();
                        window.MvPjax.navigate(url, true);
                    } else {
                        location.href = url;
                    }
                });
            });

            function updateContainerHeight() {
                const cols = updateGridColumns();
                const rows = Math.ceil(albumGrid.children.length / cols);
                const outres = rows * Size;
                cardBase.style.height = outres + "px";
                chrome.style.height = outres + "px";
            }

            updateContainerHeight();

            let resizeTimer;
            window.addEventListener("resize", () => {
                if (!document.contains(cardBase)) return;
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateContainerHeight, 100);
            });
        }

        init();
    })();
</script>